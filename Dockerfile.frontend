FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-frontend.txt ./
RUN python -m pip install --no-cache-dir -r requirements-frontend.txt

RUN useradd --create-home --uid 10001 appuser

COPY src/frontend.py ./src/frontend.py

USER appuser
EXPOSE 8501
CMD ["python", "-m", "streamlit", "run", "src/frontend.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
