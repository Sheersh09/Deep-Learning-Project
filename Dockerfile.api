FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements-inference.txt ./
RUN python -m pip install --no-cache-dir -r requirements-inference.txt

RUN useradd --create-home --uid 10001 appuser

COPY src/api.py src/inference.py src/model.py ./src/
COPY outputs/models/model_baseline.keras ./outputs/models/model_baseline.keras

USER appuser
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "src.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
